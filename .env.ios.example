# Copy to .env.ios (gitignored). Your personal team id from Xcode > Settings >
# Accounts > your Apple ID > Personal Team (10 characters). Never commit it.
CLOVERHOLLOW_TEAM_ID=XXXXXXXXXX
# Optional: the iPhone to install on, by name or UDID; the first connected
# phone is used otherwise.
