{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "chrome-devtools": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "chrome-devtools-mcp@latest",
          "--isolated",
          "--viewport=1280x720",
          "--no-usage-statistics",
          "--no-performance-crux"
        ]
      },
      "mobilebuild": {
        "type": "local",
        "command": ["npx", "-y", "mobilebuildmcp@latest", "mcp"]
      },
      "xcode": {
        "type": "local",
        "command": ["xcrun", "mcpbridge"],
        "disabled": true
      }
    }
  }
}
